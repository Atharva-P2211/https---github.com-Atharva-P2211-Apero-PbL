# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_RETRIES=3

# Aperio API Authentication & Rate Limiting
ANALYZE_API_KEY=dev_secret_analyze_key
DEMO_IP_ALLOWLIST=127.0.0.1,::1
RATE_LIMIT_ANALYZE_PER_MIN=5
RATE_LIMIT_ANALYZE_PER_HOUR=30

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aperio

# RDAP & DNS Configuration
RDAP_TIMEOUT_MS=3000
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_BOOTSTRAP_TTL_SECONDS=86400
DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query

# GeoLite2 Database Paths
GEOLITE2_ASN_PATH=data/geolite2/GeoLite2-ASN.mmdb
GEOLITE2_COUNTRY_PATH=data/geolite2/GeoLite2-Country.mmdb

# MaxMind License Keys (For Update Scripts / CI Only)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Cache TTL Configuration
VERDICT_CACHE_TTL_SECONDS=21600
RDAP_CACHE_TTL_SECONDS=86400
GEOLITE2_CACHE_TTL_SECONDS=21600
DEMO_CACHE_TTL_SECONDS=604800

# Execution Budgets
ANALYZE_MAX_DURATION_MS=30000
LOG_LEVEL=info
